FROM maven:3.9-eclipse-temurin-21 AS build

WORKDIR /app

COPY pom.xml .
COPY mvnw .
COPY .mvn .mvn

RUN chmod +x mvnw

COPY src src

RUN ./mvnw clean package -DskipTests

FROM eclipse-temurin:21-jre

WORKDIR /app

COPY --from=build /app/target/*.jar app.jar

EXPOSE 80

# Bind explicitly to all container interfaces and honor Vercel's runtime PORT.
# Lazy bean initialization reduces the amount of work required before the HTTP
# listener can start; beans are created when first needed.
ENTRYPOINT ["sh", "-c", "exec java -Dserver.address=0.0.0.0 -Dserver.port=${PORT:-80} -Dspring.main.lazy-initialization=true -jar app.jar"]
